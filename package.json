{
  "name": "portal-conferencia-entregas",
  "version": "1.2.0",
  "description": "Portal de Conferência de Entregas - Mindset7 Studio",
  "main": "electron/main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "build:dir": "electron-builder --dir",
    "build": "electron-builder",
    "firebase:deploy": "firebase deploy --only hosting",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules"
  },
  "build": {
    "appId": "com.mindset7.portal-conferencia",
    "productName": "Portal de Conferência",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*.js",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "portal-conferencia-${version}-setup.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "author": "Mindset7 Studio",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "firebase": "^12.16.0"
  }
}
